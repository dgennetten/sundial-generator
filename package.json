{
  "name": "sundial-generator",
  "version": "1.11.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "cross-env ANALYZE=true npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch-logs": "node scripts/fetchLogs.js",
    "fetch-logs-7d": "node scripts/fetchLogs.js 7",
    "fetch-logs-30d": "node scripts/fetchLogs.js 30",
    "update-visitors": "node scripts/updateVisitorData.js",
    "update-visitors-7d": "node scripts/updateVisitorData.js 7",
    "update-visitors-30d": "node scripts/updateVisitorData.js 30",
    "update-visitors-6m": "node scripts/updateVisitorData.js 180",
    "update-and-build": "node scripts/updateVisitorData.js 7 --build",
    "update-and-deploy": "npm run update-and-build && npm run deploy",
    "deploy": "node deploy.js",
    "local-deploy": "node localDeploy.js",
    "test-credentials": "node scripts/testCredentials.js",
    "update-and-local-deploy": "npm run update-visitors-7d && npm run build && npm run local-deploy",
    "test-connection": "node scripts/testConnection.js",
    "verify-credentials": "node scripts/verifyCredentials.js",
    "update-credentials": "node scripts/updateCredentials.js",
    "debug-logs": "node scripts/debugLogProcessing.js",
    "debug-logs-90d": "node scripts/debugLogProcessing.js 90",
    "cron-update": "node scripts/cronUpdate.js",
    "upload-php": "node uploadPHP.js",
    "deploy-with-php": "node deployWithPHP.js",
    "check-export-logger": "node scripts/checkExportLogger.js",
    "test-ftp": "node test-ftp-connection.js"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.7",
    "@types/leaflet": "^1.9.20",
    "dotenv": "^17.2.1",
    "ftp": "^0.3.10",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.541.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "ssh2": "^1.16.0",
    "svg2pdf.js": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/google.maps": "^3.58.1",
    "@types/html2canvas": "^0.5.35",
    "@types/jsdom": "^21.1.7",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^10.0.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
